# Vercel/Supabase values can be used directly; POSTGRES_URL is preferred.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_management
# Alternatively, keep the Supabase POSTGRES_* variables from Vercel.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
